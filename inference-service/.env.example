# Copy to .env and adjust. Every value is optional; the defaults match the
# artifact that ships with this project.

# Path is relative to the service root when started from inference-service/.
ML_MODEL_PATH=models/modelo_neumonia_cnn.keras
ML_MODEL_NAME=modelo_neumonia_cnn

# Preprocessing contract of the trained network. Change these only together
# with a retrained artifact.
ML_INPUT_WIDTH=150
ML_INPUT_HEIGHT=150
ML_GRAYSCALE=true
ML_NORMALIZATION=div_255

# Class meanings. The sigmoid output is read as P(positive_class).
ML_POSITIVE_CLASS=PNEUMONIA
ML_NEGATIVE_CLASS=NORMAL
ML_DECISION_THRESHOLD=0.5

# Upload and image limits.
ML_MAX_UPLOAD_MB=10
ML_MAX_IMAGE_DIMENSION=4096

ML_HOST=127.0.0.1
ML_PORT=8000

# Recommendation LLM (loaded lazily on the first /recommend request).
# Qwen3 thinking is disabled; sampling follows the model's non-thinking recipe.
ML_LLM_ENABLED=true
ML_LLM_MODEL_ID=Qwen/Qwen3-0.6B
ML_LLM_DEVICE=cpu
ML_LLM_DTYPE=float32
ML_LLM_MAX_NEW_TOKENS=240
ML_LLM_TEMPERATURE=0.7
ML_LLM_TOP_P=0.8
ML_LLM_TOP_K=20
ML_LLM_MIN_CHARS=200
ML_LLM_MAX_CHARS=600

# Contextual bandit RL. The JSON file holds only the Q-table and a feedback
# counter; it is ignored by git and never contains images or user data.
ML_RL_QTABLE_PATH=data/rl_qtable.json
ML_RL_ALPHA=0.2
ML_RL_EPSILON=0.15
ML_RL_LOW_CONFIDENCE_THRESHOLD=0.70
ML_RL_HIGH_CONFIDENCE_THRESHOLD=0.90
ML_RL_RECOMMENDATION_TTL_SECONDS=3600
ML_RL_MAX_PENDING_RECOMMENDATIONS=1000
# ML_RL_SEED=7
